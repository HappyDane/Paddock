<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light theme — Apple-inspired minimalism
        Bright, airy, clean. Depth via soft shadows.
    -->

    <!-- Paddock surface -->
    <SolidColorBrush x:Key="PaddockDefaultBackground" Color="#F2F2F7" />

    <!-- Icon hover / drop feedback -->
    <SolidColorBrush x:Key="PaddockDropHighlight" Color="#990A84FF" />

    <!-- Menus, tooltips and the Appearance panel -->
    <SolidColorBrush x:Key="MenuBackground" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="MenuBorder" Color="#1F000000" />
    <SolidColorBrush x:Key="MenuText" Color="#1C1C1E" />
    <SolidColorBrush x:Key="MenuTextDisabled" Color="#AEAEB2" />
    <SolidColorBrush x:Key="MenuHighlight" Color="#007AFF" />
    <SolidColorBrush x:Key="MenuHighlightText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuSeparator" Color="#14000000" />
    <SolidColorBrush x:Key="SegmentBackground" Color="#0F000000" />
    <SolidColorBrush x:Key="SegmentSelected" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SegmentSelectedText" Color="#1C1C1E" />
    <SolidColorBrush x:Key="SliderTrack" Color="#D1D1D6" />
    <SolidColorBrush x:Key="SwatchRing" Color="#1C1C1E" />

    <!-- General UI -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1C1C1E" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8E8E93" />
    <SolidColorBrush x:Key="TextTertiary" Color="#AEAEB2" />
    <SolidColorBrush x:Key="AccentColor" Color="#007AFF" />
    <SolidColorBrush x:Key="SurfaceColor" Color="#F2F2F7" />
    <SolidColorBrush x:Key="SurfaceSecondary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Separator" Color="#E5E5EA" />

    <!-- Settings window -->
    <SolidColorBrush x:Key="SettingsBackground" Color="#F2F2F7" />
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SettingsCardBorder" Color="#E5E5EA" />

    <!-- Defaults -->
    <sys:Double x:Key="PaddockDefaultOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.92</sys:Double>
    <CornerRadius x:Key="PaddockDefaultCornerRadius">16</CornerRadius>

</ResourceDictionary>
