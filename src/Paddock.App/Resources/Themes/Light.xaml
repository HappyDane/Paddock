<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paddock defaults -->
    <SolidColorBrush x:Key="PaddockTitleBarBackground" Color="#DCE0E8" />
    <SolidColorBrush x:Key="PaddockIconText" Color="#4C4F69" />

    <!-- General UI -->
    <SolidColorBrush x:Key="WindowBackground" Color="#EFF1F5" />
    <SolidColorBrush x:Key="TextPrimary" Color="#4C4F69" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6C6F85" />
    <SolidColorBrush x:Key="AccentColor" Color="#1E66F5" />
    <SolidColorBrush x:Key="AccentHover" Color="#209FB5" />
    <SolidColorBrush x:Key="SurfaceColor" Color="#CCD0DA" />
    <SolidColorBrush x:Key="BorderColor" Color="#BCC0CC" />

</ResourceDictionary>
