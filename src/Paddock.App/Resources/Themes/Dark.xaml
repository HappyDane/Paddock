<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paddock defaults -->
    <SolidColorBrush x:Key="PaddockTitleBarBackground" Color="#2A2A3D" />
    <SolidColorBrush x:Key="PaddockIconText" Color="#CDD6F4" />

    <!-- General UI -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E2E" />
    <SolidColorBrush x:Key="TextPrimary" Color="#CDD6F4" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A6ADC8" />
    <SolidColorBrush x:Key="AccentColor" Color="#89B4FA" />
    <SolidColorBrush x:Key="AccentHover" Color="#74C7EC" />
    <SolidColorBrush x:Key="SurfaceColor" Color="#313244" />
    <SolidColorBrush x:Key="BorderColor" Color="#45475A" />

</ResourceDictionary>
