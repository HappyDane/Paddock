<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark theme — Apple-inspired minimalism
        Neutral, muted palette. Depth via shadows, not borders.
    -->

    <!-- Paddock surface -->
    <SolidColorBrush x:Key="PaddockDefaultBackground" Color="#1C1C1E" />
    <SolidColorBrush x:Key="PaddockTitleText" Color="#98989D" />
    <SolidColorBrush x:Key="PaddockIconText" Color="#E5E5EA" />
    <SolidColorBrush x:Key="PaddockGripDot" Color="#48484A" />

    <!-- Icon hover / drop feedback -->
    <SolidColorBrush x:Key="PaddockIconHover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="PaddockDropHighlight" Color="#800A84FF" />

    <!-- Close button -->
    <SolidColorBrush x:Key="PaddockCloseBackground" Color="#48484A" />
    <SolidColorBrush x:Key="PaddockCloseText" Color="#98989D" />

    <!-- General UI -->
    <SolidColorBrush x:Key="WindowBackground" Color="#000000" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F7" />
    <SolidColorBrush x:Key="TextSecondary" Color="#98989D" />
    <SolidColorBrush x:Key="TextTertiary" Color="#636366" />
    <SolidColorBrush x:Key="AccentColor" Color="#0A84FF" />
    <SolidColorBrush x:Key="SurfaceColor" Color="#1C1C1E" />
    <SolidColorBrush x:Key="SurfaceSecondary" Color="#2C2C2E" />
    <SolidColorBrush x:Key="Separator" Color="#38383A" />

    <!-- Settings window -->
    <SolidColorBrush x:Key="SettingsBackground" Color="#1C1C1E" />
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#2C2C2E" />
    <SolidColorBrush x:Key="SettingsCardBorder" Color="#38383A" />

    <!-- Defaults -->
    <sys:Double x:Key="PaddockDefaultOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.88</sys:Double>
    <CornerRadius x:Key="PaddockDefaultCornerRadius">16</CornerRadius>

</ResourceDictionary>
