<Window x:Class="Paddock.App.Views.EyedropperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a colour"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnPick"
        MouseRightButtonUp="OnCancel"
        PreviewKeyDown="OnKeyDown">

    <!--
        Shown only while a colour is being picked. It shows a picture of the
        screen taken a moment before, so it looks exactly like the desktop,
        with a magnifier under the cursor.
    -->
    <Grid>
        <Image x:Name="Snapshot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <Border x:Name="Loupe"
                    Background="#F21C1C1E"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <Border Width="120" Height="120" CornerRadius="9" ClipToBounds="True" Background="Black">
                        <Grid>
                            <Rectangle x:Name="Zoom" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <!-- 15 pixels across at 8 each: the middle one is the one picked. -->
                            <Rectangle Width="10" Height="10" Stroke="Black" StrokeThickness="1" />
                            <Rectangle Width="8" Height="8" Stroke="White" StrokeThickness="1" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="2,7,2,1">
                        <Border x:Name="Preview" Width="16" Height="16" CornerRadius="4" BorderBrush="#40FFFFFF" BorderThickness="1" />
                        <TextBlock x:Name="HexText"
                                   Foreground="#F2F2F7"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="HintPanel" Background="#E01C1C1E" CornerRadius="10">
                <TextBlock Text="Click to pick a colour&#x2003;·&#x2003;arrow keys to fine-tune&#x2003;·&#x2003;Esc to cancel"
                           Foreground="#E5E5EA"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="13"
                           FontWeight="Medium"
                           Padding="18,12" />
            </Border>
        </Canvas>
    </Grid>
</Window>
