<UserControl x:Class="Paddock.App.Views.AppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Foreground="{DynamicResource MenuText}">

    <!--
        The paddock's Appearance popover. Everything applies live to the
        paddock it belongs to (its DataContext) and is saved as it settles.
    -->
    <UserControl.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Margin" Value="0,14,0,7" />
        </Style>

        <!-- Segmented control: a quiet bar, the chosen segment raised. -->
        <Style x:Key="SegmentBar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SegmentBackground}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MenuText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SegmentSelected}" />
                                <Setter Property="Foreground" Value="{DynamicResource SegmentSelectedText}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Colour swatch: a dot, ringed when chosen. -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,11,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Ring"
                                     Margin="-4"
                                     Stroke="{DynamicResource SwatchRing}"
                                     StrokeThickness="2"
                                     Visibility="Hidden" />
                            <Ellipse Fill="{Binding Brush}" Stroke="#33808080" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider: thin track, accent fill, round thumb. -->
        <Style x:Key="TrackFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentColor}" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrackRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="White" Stroke="#2E000000" StrokeThickness="0.5">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpacitySlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource SliderTrack}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackFill}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackRest}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The margin leaves room for the shadow inside the transparent popup. -->
    <Border Width="272"
            Background="{DynamicResource MenuBackground}"
            BorderBrush="{DynamicResource MenuBorder}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18,14,18,16"
            Margin="6,2,14,14"
            Effect="{StaticResource PopupShadow}">
        <StackPanel>
            <Grid>
                <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" />
                <Button Content="Reset"
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Right"
                        ToolTip="Back to the standard look"
                        Click="Reset_Click" />
            </Grid>

            <TextBlock Text="COLOR" Style="{StaticResource SectionLabel}" />
            <ItemsControl ItemsSource="{Binding Swatches}" Margin="4,2,0,-11">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Swatch}"
                                ToolTip="{Binding Name}"
                                AutomationProperties.Name="{Binding Name}"
                                Click="Swatch_Click" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <TextBlock Text="OPACITY" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{Binding OpacityText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,7" />
            </Grid>
            <Slider Style="{StaticResource OpacitySlider}"
                    AutomationProperties.Name="Opacity"
                    Minimum="0.15"
                    Maximum="1"
                    SmallChange="0.05"
                    LargeChange="0.1"
                    Value="{Binding PaddockOpacity}" />

            <TextBlock Text="ICON SIZE" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SegmentBar}">
                <UniformGrid Rows="1">
                    <RadioButton Style="{StaticResource Segment}" Content="Small" IsChecked="{Binding IsIconSmall}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Medium" IsChecked="{Binding IsIconMedium}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Large" IsChecked="{Binding IsIconLarge}" />
                </UniformGrid>
            </Border>

            <TextBlock Text="FONT" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SegmentBar}">
                <!-- Each choice is written in its own typeface. -->
                <UniformGrid Rows="1">
                    <RadioButton Style="{StaticResource Segment}" Content="System"
                                 FontFamily="Segoe UI Variable Text, Segoe UI" IsChecked="{Binding IsFontSystem}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Compact"
                                 FontFamily="Bahnschrift, Segoe UI" IsChecked="{Binding IsFontCompact}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Serif"
                                 FontFamily="Georgia, Cambria, Segoe UI" IsChecked="{Binding IsFontSerif}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Mono"
                                 FontFamily="Cascadia Mono, Consolas" IsChecked="{Binding IsFontMono}" />
                </UniformGrid>
            </Border>

            <TextBlock Text="TITLE" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource SegmentBar}">
                <UniformGrid Rows="1">
                    <RadioButton Style="{StaticResource Segment}" Content="Always" IsChecked="{Binding IsTitleAlwaysVisible}" />
                    <RadioButton Style="{StaticResource Segment}" Content="On hover" IsChecked="{Binding IsTitleHoverVisible}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Hidden" IsChecked="{Binding IsTitleHidden}" />
                </UniformGrid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
