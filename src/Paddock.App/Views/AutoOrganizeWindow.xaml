<Window x:Class="Paddock.App.Views.AutoOrganizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto-Organize"
        Width="660" Height="620"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource SettingsBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Rounded, quiet buttons in the settings card colours. -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource SettingsCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorder}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PlainButton}">
            <Setter Property="Background" Value="{DynamicResource AccentColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Small glyph buttons on each rule: up, down, remove. -->
        <Style x:Key="GlyphButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SegmentBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Auto-Organize" FontFamily="Segoe UI Variable, Segoe UI" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="New items on your desktop go straight into a paddock. Rules are checked from the top, and the first one that matches wins."
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,4,0,14" />

            <Border Background="{DynamicResource SettingsCardBackground}" CornerRadius="12" Padding="16,10" Margin="0,0,0,14">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Organize new desktop items automatically" FontSize="14" />
                        <TextBlock Text="Items you drag out of a paddock always stay where you put them."
                                   FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,1,0,0" />
                    </StackPanel>
                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                              AutomationProperties.Name="Organize new desktop items automatically"
                              IsChecked="{Binding Enabled}" />
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <TextBlock Text="No rules yet. Add one below — for example, PDFs into a Documents paddock."
                           Visibility="{Binding EmptyVisibility}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="4,12" />

                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SettingsCardBackground}" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,10,0"
                                              ToolTip="Turn this rule on or off"
                                              AutomationProperties.Name="Rule enabled" />

                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="When" Style="{StaticResource Label}" />
                                        <ComboBox Width="214" Margin="0,2,8,2"
                                                  AutomationProperties.Name="Condition"
                                                  ItemsSource="{Binding Conditions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{Binding Condition}" />

                                        <Grid Visibility="{Binding TextVisibility}" Width="180" Margin="0,2">
                                            <TextBox x:Name="ValueBox"
                                                     AutomationProperties.Name="Rule value"
                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center"
                                                     Padding="4,3" />
                                            <TextBlock Text="{Binding Hint}" IsHitTestVisible="False" Margin="8,0" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="Gray">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <ComboBox Visibility="{Binding ChoiceVisibility}" Width="180" Margin="0,2"
                                                  AutomationProperties.Name="Rule choice"
                                                  ItemsSource="{Binding Choices}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{Binding Choice}" />

                                        <StackPanel Visibility="{Binding FolderVisibility}" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding FolderName}" ToolTip="{Binding Folder}"
                                                       FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                       MaxWidth="130" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <Button Content="Choose…" Style="{StaticResource PlainButton}" Padding="10,3"
                                                    Click="Browse_Click" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource GlyphButton}" ToolTip="Move up" AutomationProperties.Name="Move rule up" Click="Up_Click">
                                            <Path Style="{StaticResource Glyph}" Data="M 0,5 L 5,0 L 10,5" />
                                        </Button>
                                        <Button Style="{StaticResource GlyphButton}" ToolTip="Move down" AutomationProperties.Name="Move rule down" Click="Down_Click">
                                            <Path Style="{StaticResource Glyph}" Data="M 0,0 L 5,5 L 10,0" />
                                        </Button>
                                        <Button Style="{StaticResource GlyphButton}" ToolTip="Remove this rule" AutomationProperties.Name="Remove rule" Click="Remove_Click">
                                            <Path Style="{StaticResource Glyph}" Data="M 0,0 L 9,9 M 9,0 L 0,9" />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="put it in" Style="{StaticResource Label}" />
                                        <ComboBox Width="214"
                                                  AutomationProperties.Name="Target paddock"
                                                  ItemsSource="{Binding Paddocks}"
                                                  DisplayMemberPath="Title"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding TargetPaddockId}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding Problem}"
                                               Visibility="{Binding ProblemVisibility}"
                                               Foreground="#FF9F0A"
                                               FontSize="12"
                                               Margin="0,6,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddRuleButton" Content="Add Rule ▾" Style="{StaticResource PlainButton}" Click="AddRule_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="AddRuleMenu" />
                    </Button.ContextMenu>
                </Button>
                <Button Content="Organize Desktop Now" Style="{StaticResource PlainButton}" Margin="8,0,0,0"
                        ToolTip="Apply the rules to what is on the desktop already"
                        Click="OrganizeNow_Click" />
            </StackPanel>
            <Button Content="Done" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Padding="22,7"
                    IsCancel="True" Click="Done_Click" />
        </Grid>
    </Grid>
</Window>
