<UserControl x:Class="Paddock.App.Views.PaddockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="Paddock_Drop"
             DragOver="Paddock_DragOver"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Fade-in animation for hover chrome -->
        <Storyboard x:Key="ShowChrome">
            <DoubleAnimation Storyboard.TargetName="HoverChrome"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.15" />
        </Storyboard>
        <Storyboard x:Key="HideChrome">
            <DoubleAnimation Storyboard.TargetName="HoverChrome"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.25" />
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource ShowChrome}" />
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource HideChrome}" />
        </EventTrigger>
    </UserControl.Triggers>

    <!-- Context menu for paddock management -->
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Rename" Click="ContextMenu_Rename" />
            <MenuItem Header="Collect Desktop Items" Click="ContextMenu_CollectDesktopItems" />
            <Separator />
            <MenuItem Header="Title Visibility">
                <MenuItem Header="Always Visible" IsCheckable="True"
                          IsChecked="{Binding IsTitleAlwaysVisible, Mode=OneWay}"
                          Click="TitleVisibility_Always" />
                <MenuItem Header="Show on Hover" IsCheckable="True"
                          IsChecked="{Binding IsTitleHoverVisible, Mode=OneWay}"
                          Click="TitleVisibility_Hover" />
                <MenuItem Header="Hidden" IsCheckable="True"
                          IsChecked="{Binding IsTitleHidden, Mode=OneWay}"
                          Click="TitleVisibility_Hidden" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Sort By">
                <MenuItem Header="Name" Click="Sort_Name" />
                <MenuItem Header="Date Modified" Click="Sort_Date" />
                <MenuItem Header="File Type" Click="Sort_Type" />
                <MenuItem Header="File Size" Click="Sort_Size" />
                <Separator />
                <MenuItem Header="Ascending" IsCheckable="True"
                          IsChecked="{Binding SortAscending}"
                          Click="Sort_ToggleDirection" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Roll Up / Expand" Click="ContextMenu_ToggleRollUp" />
            <MenuItem Header="Lock Position" IsCheckable="True"
                      IsChecked="{Binding IsLocked}" />
            <MenuItem Header="Exclude from Quick Hide" IsCheckable="True"
                      IsChecked="{Binding ExcludeFromQuickHide}" />
            <Separator />
            <MenuItem Header="Remove Paddock (icons return to desktop)"
                      Click="ContextMenu_Remove" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border CornerRadius="{Binding CornerRadius}"
            Background="{Binding BackgroundBrush}"
            BorderBrush="{Binding BorderBrush}"
            BorderThickness="{Binding BorderThickness}"
            SnapsToDevicePixels="True">

        <Grid>
            <!-- Icon grid (hidden when rolled up) -->
            <ScrollViewer Margin="6,32,6,6"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          Visibility="{Binding ContentVisibility}">
                <ItemsControl ItemsSource="{Binding Icons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="76" Height="84"
                                        Margin="2"
                                        Background="Transparent"
                                        MouseLeftButtonDown="Icon_MouseLeftButtonDown"
                                        MouseRightButtonUp="Icon_RightClick"
                                        MouseMove="Icon_MouseMove"
                                        Cursor="Hand"
                                        ToolTip="{Binding DisplayName}">

                                <Image Source="{Binding IconImage}"
                                       Width="44" Height="44"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,4"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource PaddockIconText}"
                                           FontFamily="Segoe UI Variable, Segoe UI"
                                           FontSize="10.5"
                                           FontWeight="Regular"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           LineHeight="14"
                                           MaxHeight="28" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty-state hint, so a new paddock explains itself -->
            <TextBlock Text="Drag desktop icons here"
                       Visibility="{Binding EmptyHintVisibility}"
                       Foreground="{DynamicResource PaddockTitleText}"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       FontSize="11.5"
                       Opacity="0.7"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="16,32,16,16"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <!-- Title area — handles drag-to-move and roll-up -->
            <Border x:Name="TitleArea"
                    Height="32"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                    Cursor="SizeAll">

                <Grid>
                    <!-- Title text (visibility controlled by mode) -->
                    <TextBlock x:Name="TitleText"
                               Text="{Binding Title}"
                               Foreground="{DynamicResource PaddockTitleText}"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="12"
                               FontWeight="Medium"
                               Margin="14,0,36,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Visible" />

                    <!-- Inline rename textbox (shown during rename) -->
                    <TextBox x:Name="RenameBox"
                             Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Segoe UI Variable, Segoe UI"
                             FontSize="12"
                             Margin="10,4,40,4"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"
                             KeyDown="RenameBox_KeyDown"
                             LostFocus="RenameBox_LostFocus" />
                </Grid>
            </Border>

            <!-- Hover-only chrome (close button, resize grip dots) -->
            <Grid x:Name="HoverChrome" Opacity="0">
                <Border Width="20" Height="20"
                        CornerRadius="10"
                        Background="{DynamicResource PaddockCloseBackground}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,8,0"
                        Cursor="Hand"
                        ToolTip="Remove paddock — its icons go back to the desktop"
                        MouseLeftButtonDown="CloseButton_Click">
                    <TextBlock Text="&#xD7;"
                               FontSize="14"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               Foreground="{DynamicResource PaddockCloseText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-2,0,0" />
                </Border>

                <Canvas Width="12" Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,6,6"
                        IsHitTestVisible="False"
                        Visibility="{Binding ContentVisibility}">
                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource PaddockGripDot}" Canvas.Left="9" Canvas.Top="9" />
                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource PaddockGripDot}" Canvas.Left="4.5" Canvas.Top="9" />
                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource PaddockGripDot}" Canvas.Left="9" Canvas.Top="4.5" />
                </Canvas>
            </Grid>

            <!-- Resize thumb (invisible, always hit-testable) -->
            <Thumb HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Width="18" Height="18"
                   Cursor="SizeNWSE"
                   Opacity="0"
                   Visibility="{Binding ContentVisibility}"
                   DragDelta="ResizeGrip_DragDelta"
                   DragCompleted="ResizeGrip_DragCompleted" />
        </Grid>
    </Border>
</UserControl>
