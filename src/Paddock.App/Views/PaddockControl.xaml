<UserControl x:Class="Paddock.App.Views.PaddockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="150" MinHeight="100">

    <Border x:Name="PaddockBorder"
            Background="{Binding BackgroundBrush}"
            CornerRadius="{Binding CornerRadius}"
            BorderBrush="{Binding BorderBrush}"
            BorderThickness="{Binding BorderThickness}"
            Opacity="{Binding Opacity}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />   <!-- Title bar -->
                <RowDefinition Height="*" />     <!-- Icon area -->
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PaddockTitleBarBackground}"
                    CornerRadius="{Binding TitleCornerRadius}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{Binding Title}"
                           Foreground="{Binding TitleColor}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           MouseDoubleClick="Title_DoubleClick" />
            </Border>

            <!-- Icon grid area -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Icons}"
                          Margin="8"
                          AllowDrop="True"
                          Drop="IconArea_Drop"
                          DragOver="IconArea_DragOver">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="72" Height="80"
                                    Margin="4"
                                    MouseDoubleClick="Icon_DoubleClick"
                                    MouseMove="Icon_MouseMove"
                                    Cursor="Hand">
                            <Image Source="{Binding IconImage}"
                                   Width="48" Height="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,2" />
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource PaddockIconText}"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="30" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Resize grip -->
            <Thumb Grid.Row="1"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Width="16" Height="16"
                   Cursor="SizeNWSE"
                   Opacity="0.3"
                   DragDelta="ResizeGrip_DragDelta" />
        </Grid>
    </Border>
</UserControl>
