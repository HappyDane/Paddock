<UserControl x:Class="Paddock.App.Views.PaddockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Paddock.App.Views"
             AllowDrop="True"
             Drop="Paddock_Drop"
             DragOver="Paddock_DragOver"
             DragEnter="Paddock_DragEnter"
             DragLeave="Paddock_DragLeave"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Fade-in animation for hover chrome -->
        <Storyboard x:Key="ShowChrome">
            <DoubleAnimation Storyboard.TargetName="HoverChrome"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.15" />
        </Storyboard>
        <Storyboard x:Key="HideChrome">
            <DoubleAnimation Storyboard.TargetName="HoverChrome"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.25" />
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource ShowChrome}" />
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource HideChrome}" />
        </EventTrigger>
    </UserControl.Triggers>

    <!-- Right-click menu: short, grouped, and the only way to close a paddock. -->
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Rename" Click="ContextMenu_Rename" />
            <MenuItem Header="Appearance…" Click="ContextMenu_Appearance" />
            <Separator />
            <MenuItem Header="Sort By">
                <MenuItem Header="Name" IsCheckable="True"
                          IsChecked="{Binding IsSortedByName, Mode=OneWay}"
                          Click="Sort_Name" />
                <MenuItem Header="Date Modified" IsCheckable="True"
                          IsChecked="{Binding IsSortedByDate, Mode=OneWay}"
                          Click="Sort_Date" />
                <MenuItem Header="File Type" IsCheckable="True"
                          IsChecked="{Binding IsSortedByType, Mode=OneWay}"
                          Click="Sort_Type" />
                <MenuItem Header="File Size" IsCheckable="True"
                          IsChecked="{Binding IsSortedBySize, Mode=OneWay}"
                          Click="Sort_Size" />
                <Separator />
                <MenuItem Header="Ascending" IsCheckable="True"
                          IsChecked="{Binding SortAscending, Mode=OneWay}"
                          Click="Sort_ToggleDirection" />
            </MenuItem>
            <MenuItem Header="Fill from Desktop">
                <MenuItem Header="All items" Tag="All" Click="ContextMenu_FillFromDesktop" />
                <Separator />
                <MenuItem Header="Shortcuts" Tag="Shortcuts" Click="ContextMenu_FillFromDesktop" />
                <MenuItem Header="Folders" Tag="Folders" Click="ContextMenu_FillFromDesktop" />
                <MenuItem Header="Documents" Tag="Documents" Click="ContextMenu_FillFromDesktop" />
                <MenuItem Header="Images" Tag="Images" Click="ContextMenu_FillFromDesktop" />
                <MenuItem Header="Media" Tag="Media" Click="ContextMenu_FillFromDesktop" />
                <MenuItem Header="Archives" Tag="Archives" Click="ContextMenu_FillFromDesktop" />
                <MenuItem Header="Everything else" Tag="Other" Click="ContextMenu_FillFromDesktop" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{Binding RollUpMenuText}" Click="ContextMenu_ToggleRollUp" />
            <MenuItem Header="Lock Position" IsCheckable="True"
                      IsChecked="{Binding IsLocked}" />
            <MenuItem Header="Keep Visible When Hiding" IsCheckable="True"
                      IsChecked="{Binding ExcludeFromQuickHide}"
                      ToolTip="Stays on screen when you hide your paddocks" />
            <Separator />
            <MenuItem Header="Close Paddock"
                      ToolTip="Its icons go back to the desktop"
                      Click="ContextMenu_Remove" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border CornerRadius="{Binding CornerRadius}"
            Background="{Binding BackgroundBrush}"
            BorderBrush="{Binding BorderBrush}"
            BorderThickness="{Binding BorderThickness}"
            SnapsToDevicePixels="True">

        <Grid>
            <!-- Icon grid (hidden when rolled up) -->
            <ScrollViewer Margin="6,32,6,6"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          Visibility="{Binding ContentVisibility}">
                <ItemsControl ItemsSource="{Binding Icons}">
                    <!-- Names each icon for UI Automation (screen readers, and
                         the desktop smoke test) instead of the view model's type name. -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding DataContext.IconCellWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Height="{Binding DataContext.IconCellHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Margin="2"
                                    CornerRadius="6"
                                    MouseLeftButtonDown="Icon_MouseLeftButtonDown"
                                    MouseRightButtonUp="Icon_RightClick"
                                    MouseMove="Icon_MouseMove"
                                    Cursor="Hand"
                                    ToolTip="{Binding ToolTipText}">
                                <!-- Background lives in the style so the hover
                                     trigger is not overridden by a local value. -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background"
                                                        Value="{Binding DataContext.IconHoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <Image Source="{Binding IconImage}"
                                           Width="{Binding DataContext.IconPixelSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Height="{Binding DataContext.IconPixelSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,4"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{Binding DataContext.LabelBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               FontFamily="{Binding DataContext.TextFontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               FontSize="{Binding DataContext.LabelFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               LineHeight="{Binding DataContext.LabelLineHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               MaxHeight="{Binding DataContext.LabelMaxHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               FontWeight="Regular"
                                               Margin="3,0"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty-state hint, so a new paddock explains itself -->
            <TextBlock Text="Drag desktop icons here&#x0a;or right-click to fill from the desktop"
                       Visibility="{Binding EmptyHintVisibility}"
                       Foreground="{Binding TitleBrush}"
                       FontFamily="{Binding TextFontFamily}"
                       FontSize="11.5"
                       Opacity="0.7"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="16,32,16,16"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <!-- Title area — handles drag-to-move and roll-up -->
            <Border x:Name="TitleArea"
                    Height="32"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                    Cursor="SizeAll">

                <Grid>
                    <!-- Title text (visibility controlled by mode) -->
                    <TextBlock x:Name="TitleText"
                               Text="{Binding Title}"
                               Foreground="{Binding TitleBrush}"
                               FontFamily="{Binding TextFontFamily}"
                               FontSize="12"
                               FontWeight="Medium"
                               Margin="14,0,14,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Visible" />

                    <!-- Inline rename textbox (shown during rename) -->
                    <TextBox x:Name="RenameBox"
                             Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{Binding TextFontFamily}"
                             FontSize="12"
                             Margin="10,4,10,4"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"
                             KeyDown="RenameBox_KeyDown"
                             LostFocus="RenameBox_LostFocus" />
                </Grid>
            </Border>

            <!-- Hover-only chrome: the resize grip dots -->
            <Grid x:Name="HoverChrome" Opacity="0">
                <Canvas Width="12" Height="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,6,6"
                        IsHitTestVisible="False"
                        Visibility="{Binding ContentVisibility}">
                    <Ellipse Width="2.5" Height="2.5" Fill="{Binding TitleBrush}" Canvas.Left="9" Canvas.Top="9" />
                    <Ellipse Width="2.5" Height="2.5" Fill="{Binding TitleBrush}" Canvas.Left="4.5" Canvas.Top="9" />
                    <Ellipse Width="2.5" Height="2.5" Fill="{Binding TitleBrush}" Canvas.Left="9" Canvas.Top="4.5" />
                </Canvas>
            </Grid>

            <!-- Drop feedback: outlines the paddock while a drag is over it -->
            <Border x:Name="DropHighlight"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    CornerRadius="{Binding CornerRadius}"
                    BorderBrush="{DynamicResource PaddockDropHighlight}"
                    BorderThickness="2" />

            <!-- Appearance popover, beside the paddock (flips to the other side near a screen edge) -->
            <Popup x:Name="AppearancePopup"
                   PlacementTarget="{Binding ElementName=Root}"
                   Placement="Right"
                   HorizontalOffset="4"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <views:AppearancePanel />
            </Popup>

            <!-- Resize thumb (invisible, always hit-testable) -->
            <Thumb HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Width="18" Height="18"
                   Cursor="SizeNWSE"
                   Opacity="0"
                   Visibility="{Binding ContentVisibility}"
                   DragDelta="ResizeGrip_DragDelta"
                   DragCompleted="ResizeGrip_DragCompleted" />
        </Grid>
    </Border>
</UserControl>
