<UserControl x:Class="Paddock.App.Views.PaddockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="140" MinHeight="80"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Fade-in animation for hover chrome -->
        <Storyboard x:Key="ShowChrome">
            <DoubleAnimation Storyboard.TargetName="TitleRow"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="ResizeGripVisual"
                             Storyboard.TargetProperty="Opacity"
                             To="0.5" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="CloseButton"
                             Storyboard.TargetProperty="Opacity"
                             To="0.6" Duration="0:0:0.15" />
        </Storyboard>
        <Storyboard x:Key="HideChrome">
            <DoubleAnimation Storyboard.TargetName="TitleRow"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="ResizeGripVisual"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="CloseButton"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.25" />
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Mouse.MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource ShowChrome}" />
        </EventTrigger>
        <EventTrigger RoutedEvent="Mouse.MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource HideChrome}" />
        </EventTrigger>
    </UserControl.Triggers>

    <!-- Outer wrapper with soft shadow — depth without borders -->
    <Border CornerRadius="{Binding CornerRadius}"
            Background="{Binding BackgroundBrush}"
            Opacity="{Binding Opacity}">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="24"
                              ShadowDepth="4"
                              Opacity="0.18"
                              Direction="270" />
        </Border.Effect>

        <Grid>
            <!-- Title — hidden by default, fades in on hover -->
            <TextBlock x:Name="TitleRow"
                       Text="{Binding Title}"
                       Foreground="{DynamicResource PaddockTitleText}"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       FontSize="12"
                       FontWeight="Medium"
                       Opacity="0"
                       Margin="14,8,36,0"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Left"
                       MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                       MouseDoubleClick="Title_DoubleClick"
                       Cursor="SizeAll" />

            <!-- Close button — top right, hidden until hover -->
            <Border x:Name="CloseButton"
                    Opacity="0"
                    Width="20" Height="20"
                    CornerRadius="10"
                    Background="{DynamicResource PaddockCloseBackground}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,10,0"
                    Cursor="Hand"
                    MouseLeftButtonDown="CloseButton_Click">
                <TextBlock Text="&#xD7;"
                           FontSize="14"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           Foreground="{DynamicResource PaddockCloseText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-2,0,0" />
            </Border>

            <!-- Icon grid — generous padding, clean spacing -->
            <ItemsControl ItemsSource="{Binding Icons}"
                          Margin="10,30,10,10"
                          AllowDrop="True"
                          Drop="IconArea_Drop"
                          DragOver="IconArea_DragOver">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="76" Height="84"
                                    Margin="2"
                                    MouseDoubleClick="Icon_DoubleClick"
                                    MouseMove="Icon_MouseMove"
                                    Cursor="Hand"
                                    ToolTip="{Binding DisplayName}">

                            <Image Source="{Binding IconImage}"
                                   Width="44" Height="44"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4" />

                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource PaddockIconText}"
                                       FontFamily="Segoe UI Variable, Segoe UI"
                                       FontSize="10.5"
                                       FontWeight="Regular"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       LineHeight="14"
                                       MaxHeight="28" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Resize grip — minimal dots, bottom-right, hidden until hover -->
            <Canvas x:Name="ResizeGripVisual"
                    Opacity="0"
                    Width="12" Height="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,6,6"
                    IsHitTestVisible="False">
                <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource PaddockGripDot}" Canvas.Left="9" Canvas.Top="9" />
                <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource PaddockGripDot}" Canvas.Left="4.5" Canvas.Top="9" />
                <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource PaddockGripDot}" Canvas.Left="9" Canvas.Top="4.5" />
            </Canvas>
            <Thumb HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Width="18" Height="18"
                   Cursor="SizeNWSE"
                   Opacity="0"
                   DragDelta="ResizeGrip_DragDelta" />
        </Grid>
    </Border>
</UserControl>
