<Window x:Class="Paddock.App.Views.ExitPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exit Paddock"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource SettingsBackground}">

    <Window.Resources>
        <!-- A large, two-line choice: what happens, and what it means. -->
        <Style x:Key="ChoiceButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource SettingsCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsCardBorder}" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style x:Key="ChoiceDetail" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,16">
        <TextBlock Text="Exit Paddock?"
                   FontFamily="Segoe UI Variable, Segoe UI"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" />

        <TextBlock x:Name="Message"
                   FontFamily="Segoe UI Variable, Segoe UI"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,8,0,18" />

        <Button x:Name="KeepButton"
                Style="{StaticResource ChoiceButton}"
                IsDefault="True"
                AutomationProperties.Name="Exit"
                Click="Keep_Click">
            <StackPanel>
                <TextBlock Text="Exit" Style="{StaticResource ChoiceTitle}" />
                <TextBlock Text="Icons wait in their paddocks and are back as soon as Paddock starts again."
                           Style="{StaticResource ChoiceDetail}" />
            </StackPanel>
        </Button>

        <Button Style="{StaticResource ChoiceButton}"
                AutomationProperties.Name="Put icons back on the desktop and exit"
                Click="Restore_Click">
            <StackPanel>
                <TextBlock Text="Put icons back on the desktop and exit" Style="{StaticResource ChoiceTitle}" />
                <TextBlock Text="Every icon returns to the desktop. Your paddocks stay, but empty."
                           Style="{StaticResource ChoiceDetail}" />
            </StackPanel>
        </Button>

        <Button Content="Cancel"
                IsCancel="True"
                HorizontalAlignment="Right"
                Padding="18,6"
                Margin="0,6,0,0"
                Click="Cancel_Click" />
    </StackPanel>
</Window>
