<Window x:Class="Paddock.App.Views.DrawRectangleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paddock outline"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        Focusable="False">

    <!-- Same look as the rectangle drawn from the tray's "New Paddock..." -->
    <Border BorderBrush="#990A84FF"
            BorderThickness="2"
            Background="#330A84FF"
            CornerRadius="8">
        <Border x:Name="SizeLabel"
                Background="#E01C1C1E"
                CornerRadius="6"
                Padding="8,3"
                Margin="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
            <TextBlock x:Name="SizeText"
                       Foreground="#E5E5EA"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       FontSize="11" />
        </Border>
    </Border>
</Window>
