<Window x:Class="Paddock.App.Views.DesktopOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paddock Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <!-- Main canvas where paddocks are rendered -->
    <Canvas x:Name="PaddockCanvas"
            Background="Transparent"
            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
            MouseRightButtonDown="Canvas_MouseRightButtonDown"
            MouseRightButtonUp="Canvas_MouseRightButtonUp"
            MouseMove="Canvas_MouseMove">

        <!-- Paddock controls are added programmatically -->

        <!-- Selection rectangle shown while drawing -->
        <Border x:Name="SelectionRect"
                Visibility="Collapsed"
                BorderBrush="#600A84FF"
                BorderThickness="2"
                Background="#200A84FF"
                CornerRadius="4"
                IsHitTestVisible="False" />

        <!-- "Create new area" popup shown after drawing -->
        <Border x:Name="CreatePopup"
                Visibility="Collapsed"
                Background="#E01C1C1E"
                CornerRadius="8"
                Padding="0"
                Cursor="Hand"
                MouseLeftButtonDown="CreatePopup_Click">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="16"
                                  ShadowDepth="2"
                                  Opacity="0.4"
                                  Direction="270" />
            </Border.Effect>
            <TextBlock Text="Create new area here"
                       Foreground="#E5E5EA"
                       FontFamily="Segoe UI Variable, Segoe UI"
                       FontSize="13"
                       FontWeight="Medium"
                       Padding="16,10"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Border>

    </Canvas>

</Window>
