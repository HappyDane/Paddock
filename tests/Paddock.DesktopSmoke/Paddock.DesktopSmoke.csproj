<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end test of the real Paddock.exe on a real Windows desktop: drags
    desktop icons in with the mouse, sorts, drags them out, restarts, and checks
    the files and what is on screen after each step. It moves files on the
    desktop and wipes Paddock's settings, so it refuses to run unless
    PADDOCK_SMOKE_TEST=1 (CI sets it). Not a unit test: `dotnet test` skips it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Paddock.DesktopSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

</Project>
